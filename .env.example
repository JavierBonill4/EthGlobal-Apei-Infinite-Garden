# Copy to .env and fill in. .env is gitignored -- keep it that way.

# --- chain ---
# This game asks every player for a transaction a day. It is an L2 game.
# Mainnet gas would be several times the size of the entry stake itself.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
ETHERSCAN_API_KEY=

# Deployer key. Use a throwaway for testnet.
PRIVATE_KEY=

# Local anvil only. MockRandomness lets anyone choose the roll -- setting this
# true on a public network hands the world's fate to whoever calls settlement.
USE_MOCK_RANDOMNESS=false

# --- chainlink vrf ---
# Rolls the per-epoch water requirement. NOT block.prevrandao: settleBegin() is
# permissionless, so a caller who could see the word first would simply decline
# to settle epochs they dislike.
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=

# --- the graph ---
# The draw ledger is the demo. It is also a subgraph.
GRAPH_DEPLOY_KEY=
SUBGRAPH_SLUG=

# --- frontend ---
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_GARDEN_ADDRESS=
NEXT_PUBLIC_STANDING_ADDRESS=
NEXT_PUBLIC_COLLECTIBLES_ADDRESS=
NEXT_PUBLIC_SUBGRAPH_URL=

# Privy: embedded wallets. The entry stake is trivial as money; requiring a
# funded wallet at all is the thing that actually costs you players.
NEXT_PUBLIC_PRIVY_APP_ID=

# World ID: personhood on the completion headcount specifically, which is the
# number worth attacking.
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION_ID=

# ENS v2 (Sepolia beta while it is in beta)
NEXT_PUBLIC_ENS_PARENT=garden.eth
