# Foundry reads .env from the directory you run `forge` in.
# Copy this to contracts/.env  (NOT the repo root -- see note in README).

# --- local anvil ---
# Anvil's account #0. This key is printed in anvil's banner on every start and
# is known to everyone on earth. It is fine for localhost and must NEVER hold
# real funds or touch a public network.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deploys MockRandomness, where anyone can choose the roll. That is the point
# locally and a catastrophe anywhere else -- it hands the world's fate to
# whoever calls settlement. Never true on a public network.
USE_MOCK_RANDOMNESS=true

# Filled in from the Deploy script's output. Used by script/LocalSettle.s.sol.
GARDEN_ADDRESS=
RNG_ADDRESS=

# --- testnet (leave empty until you need it) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
ETHERSCAN_API_KEY=

# --- chainlink vrf (leave empty until you leave localhost) ---
# Get these from the Chainlink VRF docs and the subscription manager at
# vrf.chain.link -- coordinator addresses and key hashes are per-network and
# change between VRF versions, so copy them from the source, don't trust a
# value someone pasted for you.
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=
