# Next.js reads .env.local from web/, not from the repo root.
# Copy this to web/.env.local

# 31337 is anvil. 84532 is Base Sepolia. Getting this wrong is the most common
# reason a local wallet silently refuses to sign.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# From the Deploy script's output.
NEXT_PUBLIC_GARDEN_ADDRESS=
NEXT_PUBLIC_STANDING_ADDRESS=
NEXT_PUBLIC_COLLECTIBLES_ADDRESS=

# Empty is fine. The draw ledger shows a "not indexed yet" panel instead of
# data, and everything else works.
NEXT_PUBLIC_SUBGRAPH_URL=

# --- not wired yet; empty is correct ---
# Privy: embedded wallets. The stake is trivial as money -- requiring a funded
# wallet at all is what actually costs you players.
NEXT_PUBLIC_PRIVY_APP_ID=

# World ID: personhood on the completion headcount specifically, which is the
# number worth attacking.
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION_ID=

# ENS v2. Display only until the resolver exists.
NEXT_PUBLIC_ENS_PARENT=garden.eth
